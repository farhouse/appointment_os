// prisma/schema.prisma

generator client {
  provider   = "prisma-client-js"
  // Ensure query engine binary is generated (needed for Docker/alpine dev & predictable runtime).
  engineType = "binary"
  // Support local macOS dev (native) and Docker alpine (linux-musl).
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  OWNER
  ADMIN
  MANAGER
  BARBER
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  FINISHED
  PAID
  CANCELED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum CashMovementType {
  DEPOSIT
  WITHDRAWAL
}

// Models

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         UserBranch[]
  appointments  Appointment[]
  stock         BranchStock[]
  stockMovements StockMovement[]
  sales         Sale[]
  cashBoxes     CashBox[]
  cashSessions  CashSession[]
  workingHours  BranchWorkingHour[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?  @unique
  password  String
  name      String
  role      Role     @default(BARBER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      UserBranch[]
  appointments  Appointment[] // As the professional
  confirmedAppointments Appointment[] @relation("ConfirmedBy")
  paidAppointments      Appointment[] @relation("PaidBy")
  sales         Sale[]
  auditLogs     AuditLog[]
  workingHours  BarberWorkingHour[]
}

model UserBranch {
  userId    String
  branchId  String
  user      User    @relation(fields: [userId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal
  duration    Int      // in minutes
  pointsReward Int     @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointmentServices AppointmentService[]
  saleItems           SaleItem[]
}

model Client {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String?
  email       String?  @unique
  phone       String?  @unique
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments  Appointment[]
  sales         Sale[]
  loyaltyLedger LoyaltyLedger[]
  redemptions   Redemption[]
}

model Appointment {
  id             String            @id @default(uuid())
  branchId       String
  clientId       String
  professionalId String? // User (Employee)
  status         AppointmentStatus @default(PENDING)
  startTime      DateTime
  endTime        DateTime
  notes          String?
  
  // Confirmation details
  confirmedAt    DateTime?
  confirmedById  String?
  confirmedBy    User?    @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  confirmToken   String?  @unique
  confirmTokenExpiresAt DateTime?

  // Upsell / Associated Sale
  sale Sale?

  // Payment details
  paidAt        DateTime?
  paidById      String?
  paidBy        User?    @relation("PaidBy", fields: [paidById], references: [id])
  paidCashBoxId String?
  paidPaymentMethod PaymentMethod?
  paidPaymentMediumId String?
  paidAmount   Decimal?
  paidCashBox  CashBox? @relation("PaidCashBox", fields: [paidCashBoxId], references: [id])
  paidPaymentMedium PaymentMethodConfig? @relation("AppointmentPaidPaymentMedium", fields: [paidPaymentMediumId], references: [id])

  // Notification toggles
  notifyEmail    Boolean  @default(true)
  notifySms      Boolean  @default(false)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch       Branch               @relation(fields: [branchId], references: [id])
  client       Client               @relation(fields: [clientId], references: [id])
  professional User?                @relation(fields: [professionalId], references: [id])
  services     AppointmentService[]
  cashMovements CashMovement[]
  loyaltyLedger LoyaltyLedger?
  
  @@index([branchId])
  @@index([clientId])
  @@index([professionalId])
  @@index([startTime, endTime])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  price         Decimal // Snapshot of price at appointment creation time
  duration      Int     // Snapshot of duration

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  description String?
  price       Decimal
  cost        Decimal?
  pointsCost  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchStock    BranchStock[]
  stockMovements StockMovementItem[]
  saleItems      SaleItem[]
  redemptions    Redemption[]
}

model BranchStock {
  branchId  String
  productId String
  quantity  Int     @default(0)
  minStock  Int     @default(0)
  
  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([branchId, productId])
}

model StockMovement {
  id          String            @id @default(uuid())
  branchId    String
  type        StockMovementType
  reference   String?           // e.g., Purchase Order # or Sale ID
  createdAt   DateTime          @default(now())
  
  branch      Branch              @relation(fields: [branchId], references: [id])
  items       StockMovementItem[]
}

model StockMovementItem {
  id              String   @id @default(uuid())
  movementId      String
  productId       String
  quantity        Int
  
  movement StockMovement @relation(fields: [movementId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])
}

model Sale {
  id            String        @id @default(uuid())
  branchId      String
  clientId      String?
  userId        String?       // Seller
  total         Decimal
  paymentMethod PaymentMethod?
  paymentMediumId String?
  createdAt     DateTime      @default(now())
  
  branch Branch @relation(fields: [branchId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])
  
  appointmentId String? @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  
  user   User?   @relation(fields: [userId], references: [id])
  paymentMedium PaymentMethodConfig? @relation("SalePaymentMedium", fields: [paymentMediumId], references: [id])
  items  SaleItem[]
  cashMovements CashMovement[]
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  productId String?
  serviceId String?
  name      String
  quantity  Int
  price     Decimal
  
  sale    Sale     @relation(fields: [saleId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
}

model LoyaltyLedger {
  id          String   @id @default(uuid())
  clientId    String
  appointmentId String? @unique
  points      Int      // Can be negative for usage
  reason      String?
  createdAt   DateTime @default(now())

  client      Client       @relation(fields: [clientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
}

model Redemption {
  id         String   @id @default(uuid())
  clientId   String
  productId  String
  quantity   Int
  pointsCost Int
  createdAt  DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([clientId])
  @@index([productId])
}

model CashBox {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id])
  cashSessions CashSession[]
  paidAppointments Appointment[] @relation("PaidCashBox")

  @@index([branchId])
  @@unique([branchId, name])
}

model CashSession {
  id           String    @id @default(uuid())
  branchId     String
  cashBoxId    String?
  openedBy     String    // User ID
  closedBy     String?   // User ID
  openingTime  DateTime  @default(now())
  closingTime  DateTime?
  openingBalance Decimal
  closingBalance Decimal?
  closingCash  Decimal?
  closingCard  Decimal?
  closingTransfer Decimal?
  closingOther Decimal?
  
  branch Branch @relation(fields: [branchId], references: [id])
  cashBox CashBox? @relation(fields: [cashBoxId], references: [id])
  movements CashMovement[]
  
  // Note: Uniqueness by (branchId, date) is enforced in app logic to keep legacy data safe.
  date         DateTime // Store date at 00:00:00Z
  
  @@index([branchId, date])
  @@index([cashBoxId])
}

model CashMovement {
  id            String           @id @default(uuid())
  sessionId     String
  appointmentId String?
  saleId        String?
  paymentMethod PaymentMethod    @default(CASH)
  paymentMediumId String?
  amount        Decimal
  type          CashMovementType
  reason        String?
  createdAt     DateTime         @default(now())
  
  session CashSession @relation(fields: [sessionId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  sale Sale? @relation(fields: [saleId], references: [id])
  paymentMedium PaymentMethodConfig? @relation("CashMovementPaymentMedium", fields: [paymentMediumId], references: [id])

  @@index([appointmentId])
  @@index([saleId])
}

model PaymentMethodConfig {
  id          String        @id @default(uuid())
  method      PaymentMethod
  name        String
  description String?
  active      Boolean       @default(true)
  isSystem    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  paidAppointments Appointment[] @relation("AppointmentPaidPaymentMedium")
  sales            Sale[]        @relation("SalePaymentMedium")
  cashMovements    CashMovement[] @relation("CashMovementPaymentMedium")

  @@index([method])
  @@index([active])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())
  
  user User? @relation(fields: [userId], references: [id])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String?
  body      String
  type      String   // EMAIL, SMS, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  jobs NotificationJob[]
}

model NotificationJob {
  id         String   @id @default(uuid())
  templateId String
  recipient  String
  status     String   // PENDING, SENT, FAILED
  sentAt     DateTime?
  error      String?
  createdAt  DateTime @default(now())
  
  template NotificationTemplate @relation(fields: [templateId], references: [id])
}

model BranchWorkingHour {
  id        String   @id @default(uuid())
  branchId  String
  dayOfWeek Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime String   // HH:mm format
  endTime   String   // HH:mm format
  isWorking Boolean  @default(true) // false = day off
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
}

model BarberWorkingHour {
  id           String   @id @default(uuid())
  userId       String
  dayOfWeek    Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime    String   // HH:mm format
  endTime     String   // HH:mm format
  isWorking    Boolean  @default(true) // false = day off
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
}
